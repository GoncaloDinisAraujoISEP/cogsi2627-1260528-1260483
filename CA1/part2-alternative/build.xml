<?xml version="1.0" encoding="UTF-8"?>
<project name="bookstore" default="build" basedir="." xmlns:ivy="antlib:org.apache.ivy.ant">

    <description>Bookstore built with Apache Ant + Apache Ivy (alternative to Gradle)</description>

    <!-- ================= Properties ================= -->
    <property name="version"      value="1.0.0"/>
    <property name="main.class"   value="com.example.bookstore.BookstoreApplication"/>
    <property name="java.release" value="17"/>

    <property name="src.main"     location="src/main/java"/>
    <property name="res.main"     location="src/main/resources"/>
    <property name="src.it"       location="src/integrationTest/java"/>
    <property name="dist.scripts" location="src/dist/bin"/>
    <property name="lib.dir"      location="lib"/>

    <property name="build.dir"    location="build"/>
    <property name="classes.main" location="${build.dir}/classes/main"/>
    <property name="classes.it"   location="${build.dir}/classes/integrationTest"/>
    <property name="libs.dir"     location="${build.dir}/libs"/>
    <property name="app.jar"      location="${libs.dir}/${ant.project.name}-${version}.jar"/>
    <property name="deploy.dir"   location="${build.dir}/deployment/dev"/>
    <property name="install.dir"  location="${build.dir}/install/${ant.project.name}"/>
    <property name="javadoc.dir"  location="${build.dir}/docs/javadoc"/>
    <property name="dist.dir"     location="${build.dir}/distributions"/>
    <property name="reports.it"   location="${build.dir}/reports/integrationTest"/>

    <!-- Evaluated on every run: Ant has no configuration cache -->
    <tstamp>
        <format property="build.timestamp" pattern="yyyy-MM-dd'T'HH:mm:ss"/>
    </tstamp>

    <!-- ================= Ivy bootstrap ================= -->
    <property name="ivy.version"  value="2.5.2"/>
    <property name="ivy.jar.dir"  location=".ivy"/>
    <property name="ivy.jar.file" location="${ivy.jar.dir}/ivy-${ivy.version}.jar"/>
    <available file="${ivy.jar.file}" property="ivy.present"/>

    <target name="downloadIvy" unless="ivy.present">
        <mkdir dir="${ivy.jar.dir}"/>
        <get src="https://repo1.maven.org/maven2/org/apache/ivy/ivy/${ivy.version}/ivy-${ivy.version}.jar"
             dest="${ivy.jar.file}" usetimestamp="true"/>
    </target>

    <target name="initIvy" depends="downloadIvy">
        <taskdef resource="org/apache/ivy/ant/antlib.xml" uri="antlib:org.apache.ivy.ant"
                 classpath="${ivy.jar.file}"/>
    </target>

    <!-- ================= Dependencies ================= -->
    <target name="resolve" depends="initIvy" description="Download dependencies into lib/compile, lib/runtime and lib/test">
        <ivy:retrieve pattern="${lib.dir}/[conf]/[artifact]-[revision](-[classifier]).[ext]"
                      type="jar,bundle" sync="true"/>
        <path id="compile.path"><fileset dir="${lib.dir}/compile" includes="*.jar"/></path>
        <path id="runtime.path"><fileset dir="${lib.dir}/runtime" includes="*.jar"/></path>
        <path id="test.path"><fileset dir="${lib.dir}/test" includes="*.jar"/></path>
    </target>

    <!-- ================= Build ================= -->
    <target name="compile" depends="resolve" description="Compile the application">
        <mkdir dir="${classes.main}"/>
        <javac srcdir="${src.main}" destdir="${classes.main}" classpathref="compile.path"
               release="${java.release}" encoding="UTF-8" includeantruntime="false" debug="true">
            <!-- Keeps parameter names (needed by Spring for @PathVariable) -->
            <compilerarg value="-parameters"/>
        </javac>
        <copy todir="${classes.main}">
            <fileset dir="${res.main}"/>
        </copy>
    </target>

    <target name="jar" depends="compile" description="Package the application jar">
        <mkdir dir="${libs.dir}"/>
        <!-- Class-Path entries point to lib/, so the jar runs with java -jar next to a lib/ folder -->
        <pathconvert property="manifest.classpath" pathsep=" " refid="runtime.path">
            <chainedmapper>
                <flattenmapper/>
                <globmapper from="*" to="lib/*"/>
            </chainedmapper>
        </pathconvert>
        <jar destfile="${app.jar}" basedir="${classes.main}">
            <manifest>
                <attribute name="Main-Class" value="${main.class}"/>
                <attribute name="Class-Path" value="${manifest.classpath}"/>
                <attribute name="Implementation-Version" value="${version}"/>
            </manifest>
        </jar>
    </target>

    <target name="run" depends="compile" description="Run the application (equivalent to bootRun)">
        <java classname="${main.class}" fork="true" failonerror="true">
            <classpath>
                <pathelement location="${classes.main}"/>
                <path refid="runtime.path"/>
            </classpath>
        </java>
    </target>

    <!-- ================= deployToDev ================= -->
    <target name="cleanDeployDev">
        <delete dir="${deploy.dir}"/>
    </target>

    <target name="copyAppToDev" depends="jar,cleanDeployDev">
        <copy file="${app.jar}" todir="${deploy.dir}"/>
    </target>

    <target name="copyLibsToDev" depends="resolve,cleanDeployDev">
        <copy todir="${deploy.dir}/lib" flatten="true">
            <path refid="runtime.path"/>
        </copy>
    </target>

    <target name="copyConfigToDev" depends="cleanDeployDev">
        <copy todir="${deploy.dir}" overwrite="true">
            <fileset dir="${res.main}" includes="*.properties"/>
            <filterset>
                <filter token="projectVersion" value="${version}"/>
                <filter token="buildTimestamp" value="${build.timestamp}"/>
            </filterset>
        </copy>
    </target>

    <target name="deployToDev" depends="cleanDeployDev,copyAppToDev,copyLibsToDev,copyConfigToDev"
            description="Clean and copy app, runtime libs and config to build/deployment/dev"/>

    <!-- ================= installDist / runDist ================= -->
    <target name="installDist" depends="jar" description="Create build/install/bookstore with lib/ and bin/ scripts">
        <delete dir="${install.dir}"/>
        <copy file="${app.jar}" todir="${install.dir}/lib"/>
        <copy todir="${install.dir}/lib" flatten="true">
            <path refid="runtime.path"/>
        </copy>
        <copy todir="${install.dir}/bin">
            <fileset dir="${dist.scripts}"/>
            <filterset>
                <filter token="mainClass" value="${main.class}"/>
            </filterset>
        </copy>
        <fixcrlf srcdir="${install.dir}/bin" includes="*.bat" eol="crlf"/>
        <fixcrlf srcdir="${install.dir}/bin" excludes="*.bat" eol="lf"/>
        <chmod file="${install.dir}/bin/${ant.project.name}" perm="755"/>
    </target>

    <target name="runDist" depends="installDist" description="Run the app with the start script for the current OS">
        <exec executable="cmd" osfamily="windows" dir="${install.dir}/bin" failonerror="true">
            <arg value="/c"/>
            <arg value="${ant.project.name}.bat"/>
        </exec>
        <exec executable="${install.dir}/bin/${ant.project.name}" osfamily="unix"
              dir="${install.dir}/bin" failonerror="true"/>
    </target>

    <!-- ================= javadocZip ================= -->
    <target name="javadoc" depends="resolve" description="Generate the Javadoc">
        <delete dir="${javadoc.dir}"/>
        <javadoc destdir="${javadoc.dir}" classpathref="compile.path" access="private"
                 failonerror="false" encoding="UTF-8" charset="UTF-8" source="${java.release}"
                 windowtitle="Bookstore API" doctitle="Bookstore API">
            <packageset dir="${src.main}"/>
            <link href="https://docs.oracle.com/en/java/javase/17/docs/api/"/>
        </javadoc>
    </target>

    <target name="javadocZip" depends="javadoc" description="Zip the generated Javadoc">
        <mkdir dir="${dist.dir}"/>
        <zip destfile="${dist.dir}/${ant.project.name}-${version}-javadoc.zip" basedir="${javadoc.dir}"/>
    </target>

    <!-- ================= Integration tests ================= -->
    <target name="compileIntegrationTest" depends="compile">
        <mkdir dir="${classes.it}"/>
        <javac srcdir="${src.it}" destdir="${classes.it}" release="${java.release}"
               encoding="UTF-8" includeantruntime="false" debug="true">
            <classpath>
                <pathelement location="${classes.main}"/>
                <path refid="test.path"/>
            </classpath>
            <compilerarg value="-parameters"/>
        </javac>
    </target>

    <target name="integrationTest" depends="compileIntegrationTest" description="Run the integration tests">
        <mkdir dir="${reports.it}"/>
        <junitlauncher haltOnFailure="true" printSummary="true">
            <classpath>
                <pathelement location="${classes.it}"/>
                <pathelement location="${classes.main}"/>
                <path refid="test.path"/>
            </classpath>
            <testclasses outputdir="${reports.it}">
                <fileset dir="${classes.it}" includes="**/*IT.class"/>
                <fork dir="${basedir}"/>
                <listener type="legacy-xml" sendSysOut="true" sendSysErr="true"/>
                <listener type="legacy-plain" sendSysOut="false"/>
            </testclasses>
        </junitlauncher>
    </target>

    <!-- ================= Lifecycle ================= -->
    <target name="build" depends="jar,integrationTest" description="Compile, package and run the integration tests"/>

    <target name="clean" description="Delete build output">
        <delete dir="${build.dir}"/>
    </target>

    <target name="cleanAll" depends="clean" description="Delete build output and downloaded libraries">
        <delete dir="${lib.dir}"/>
    </target>
</project>

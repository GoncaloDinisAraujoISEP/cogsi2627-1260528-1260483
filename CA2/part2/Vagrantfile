# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"
  config.vm.box_version = "202404.26.0"

  config.vm.boot_timeout = 800
  config.ssh.insert_key = false
  config.ssh.verify_host_key = false
  config.ssh.private_key_path = ["~/.vagrant.d/insecure_private_key", "keys/id_rsa"]

  config.vm.provider "virtualbox" do |vb|
    vb.cpus = 2
    vb.memory = 1536
    vb.customize ["modifyvm", :id, "--cableconnected1", "on"]
    vb.customize ["modifyvm", :id, "--natdnshostresolver1", "on"]
  end

  # VM 1: BASE DE DADOS (H2 Server)
  config.vm.define "db" do |db|
    db.vm.hostname = "db"
    db.vm.network "private_network", ip: "192.168.56.10"
    db.vm.network "forwarded_port", guest: 22, host: 2220, id: "ssh", auto_correct: false
    db.vm.provision "file", source: "keys/id_rsa.pub", destination: "/tmp/id_rsa.pub"
    db.vm.provision "shell", path: "db_provision.sh"
  end

  # VM 2: APLICAÇÃO (Spring Boot)
  config.vm.define "app" do |app|
    app.vm.hostname = "app"
    app.vm.network "private_network", ip: "192.168.56.11"
    app.vm.network "forwarded_port", guest: 22, host: 2221, id: "ssh", auto_correct: false
    app.vm.synced_folder "../../CA1/part2", "/vagrant_ca1"
    app.vm.provision "file", source: "keys/id_rsa.pub", destination: "/tmp/id_rsa.pub"
    app.vm.provision "shell", path: "app_provision.sh"
  end

# VM 3: REVERSE PROXY (Nginx)
  config.vm.define "proxy" do |proxy|
    proxy.vm.hostname = "proxy"
    proxy.vm.network "private_network", ip: "192.168.56.12"
    proxy.vm.network "forwarded_port", guest: 22, host: 2222, id: "ssh", auto_correct: false
    proxy.vm.network "forwarded_port", guest: 80, host: 8080
    proxy.vm.provider "virtualbox" do |vb|
      vb.cpus = 1
      vb.memory = 512
    end
    proxy.vm.provision "file", source: "keys/id_rsa.pub", destination: "/tmp/id_rsa.pub"
    proxy.vm.provision "shell", path: "proxy_provision.sh"
  end
end
# CA2 - Part 1: single VM running the Bookstore (CA1/part2) and the chat server (CA1/part1)

Vagrant.configure("2") do |config|
  # Ubuntu 24.04 LTS from the Bento project (Chef): open source, built with Packer from the
  # official Ubuntu ISOs, ships VirtualBox Guest Additions. Pinned for reproducible builds.
  config.vm.box = "bento/ubuntu-24.04"
  config.vm.box_version = "202510.26.0"   # check with: vagrant box list

  config.vm.hostname = "cogsi-ca2"

  config.vm.provider "virtualbox" do |vb|
    vb.name   = "cogsi-ca2-part1"
    vb.cpus   = 2
    vb.memory = 4096
	vb.customize ["modifyvm", :id, "--cable-connected1", "on"]
	
	config.vm.boot_timeout = 900
  end

  # Access from the Windows host
  config.vm.network "forwarded_port", guest: 8080,  host: 8080   # Bookstore
  config.vm.network "forwarded_port", guest: 59001, host: 59001  # chat server

  # Dedicated synced folder for the H2 database files (not the project folder)
  config.vm.synced_folder "./h2-data", "/h2-data", create: true,
    owner: "vagrant", group: "vagrant"

  # Environment variables that control the provisioning steps (set them on the host before vagrant up)
  env = {
    "REPO_URL"     => ENV.fetch("REPO_URL", "https://github.com/GoncaloDinisAraujoISEP/cogsi2627-1260528-1260483.git"),
    "REPO_BRANCH"  => ENV.fetch("REPO_BRANCH", "main"),
    "GITHUB_TOKEN" => ENV.fetch("GITHUB_TOKEN", ""),
    "CHAT_DIR"     => ENV.fetch("CHAT_DIR", "CA1/part1"),
    "CLONE_REPO"   => ENV.fetch("CLONE_REPO", "true"),
    "BUILD_APPS"   => ENV.fetch("BUILD_APPS", "true"),
    "START_APPS"   => ENV.fetch("START_APPS", "true"),
  }

  # Install, clone and build (runs on the first `vagrant up` and on `vagrant provision`)
  config.vm.provision "setup", type: "shell", path: "provision.sh", env: env

  # Start the apps on every boot, after the synced folders are mounted
  config.vm.provision "start", type: "shell", path: "start-apps.sh", run: "always", env: env
end